node_modules/
dist/
target/
release/
*.tsbuildinfo

# Generated by tauri-build on every compile
src-tauri/gen/schemas/

# Local secrets and overrides — never committed.
.env
.env.*
!.env.example

# fix-mojibake.mjs writes these next to the files it repairs. They are much older
# revisions of them and match almost every symbol search, so they never belong in
# the source tree; kept out of the way under .scratch/ instead.
*.mojibake-bak
.scratch/

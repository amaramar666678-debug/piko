{
  "name": "piko-windows",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/agent-routing.mjs",
    "sounds": "node scripts/gen-sounds.mjs",
    "shot": "node scripts/shot.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "characters": "esbuild scripts/preview-characters.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/preview-characters.mjs --log-level=error && node node_modules/.cache/preview-characters.mjs",
    "faces": "esbuild scripts/faces-harness.ts --bundle --format=esm --outfile=dist/faces-harness.js --log-level=error",
    "tauri": "tauri",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
